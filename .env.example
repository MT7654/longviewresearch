# Longview Research — optional server-side Gemini configuration
#
# The complete sample and calculation-only paths work without any API key.
# Never expose this key with a NEXT_PUBLIC_ prefix.
GOOGLE_API_KEY=

# Stable, free-tier-friendly model routing.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Optional canonical deployment origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
